// Mail Pilot Database Schema
// Generated: 2026-01-17
// Models: CustomUser, Client, MessageTemplate, Campaign

Project mail_pilot {
  database_type: 'PostgreSQL'
  Note: 'Email mailing service with campaign management'
}

// ============================================
// USERS APP
// ============================================

Table users_customuser {
  id integer [pk, increment, note: 'Primary key']

  // AbstractUser inherited fields
  username varchar(150) [not null, unique, note: 'Django username field']
  first_name varchar(150) [null]
  last_name varchar(150) [null]
  is_staff boolean [default: false, note: 'Admin panel access']
  is_active boolean [default: true, note: 'Account active status']
  is_superuser boolean [default: false]
  date_joined timestamp [not null, default: `now()`]
  last_login timestamp [null]
  password varchar(128) [not null, note: 'Hashed password']

  // CustomUser fields
  email varchar(254) [not null, unique, note: 'Login field (USERNAME_FIELD)']
  phone_number varchar(15) [null]
  avatar varchar(100) [null, note: 'ImageField path to avatars/']
  country varchar(100) [null]

  Indexes {
    email [unique, name: 'idx_user_email']
    username [unique, name: 'idx_user_username']
  }

  Note: 'Extended Django user model. Login via email.'
}

// ============================================
// CAMPAIGNS APP
// ============================================

Table campaigns_client {
  id integer [pk, increment]
  email varchar(254) [not null, unique, note: 'Unique globally across all users']
  full_name varchar(255) [not null]
  comment text [null]
  owner_id integer [not null, ref: > users_customuser.id, note: 'FK to user who created this client']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    email [unique, name: 'idx_client_email']
    owner_id [name: 'idx_client_owner']
    full_name [name: 'idx_client_name']
  }

  Note: 'Email recipients (customers). Each user owns their own clients.'
}

Table campaigns_messagetemplate {
  id integer [pk, increment]
  subject varchar(255) [not null]
  body text [not null]
  owner_id integer [not null, ref: > users_customuser.id, note: 'FK to user who created this template']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    owner_id [name: 'idx_template_owner']
    created_at [name: 'idx_template_created']
  }

  Note: 'Email templates with subject and body. Reusable across campaigns.'
}

Table campaigns_campaign {
  id integer [pk, increment]
  message_template_id integer [not null, ref: > campaigns_messagetemplate.id, note: 'PROTECT: cannot delete template if used in campaign']
  owner_id integer [not null, ref: > users_customuser.id, note: 'FK to user who created this campaign']
  status varchar(20) [not null, default: 'created', note: 'Choices: created, in_progress, finished']
  start_time timestamp [not null, note: 'Campaign start time']
  end_time timestamp [not null, note: 'Campaign end time']
  created_at timestamp [not null, default: `now()`]

  Indexes {
    owner_id [name: 'idx_campaign_owner']
    message_template_id [name: 'idx_campaign_template']
    status [name: 'idx_campaign_status']
    created_at [name: 'idx_campaign_created']
  }

  Note: 'Email campaigns. Status updates dynamically via update_status() method.'
}

// Many-to-Many relationship table
Table campaigns_campaign_clients {
  id integer [pk, increment]
  campaign_id integer [not null, ref: > campaigns_campaign.id]
  client_id integer [not null, ref: > campaigns_client.id]

  Indexes {
    (campaign_id, client_id) [unique, name: 'idx_campaign_clients_unique']
    campaign_id [name: 'idx_m2m_campaign']
    client_id [name: 'idx_m2m_client']
  }

  Note: 'M2M intermediate table linking campaigns to clients (recipients)'
}

